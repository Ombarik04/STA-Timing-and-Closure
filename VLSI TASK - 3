module top (
    input  wire       clk,
    input  wire       rst_n,
    input  wire [7:0] data_in,
    output reg  [7:0] data_out,
    output reg        valid_out
);

    wire [15:0] intermediate;
    reg         valid_pipe;

    // Combinational arithmetic path
    assign intermediate =
        (data_in * data_in) +
        ({12'b0, data_in[3:0]} << 4);

    // Valid signal pipeline
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            valid_pipe <= 1'b0;
            valid_out  <= 1'b0;
        end else begin
            valid_pipe <= 1'b1;
            valid_out  <= valid_pipe;
        end
    end

    // Combinational output logic
    always @(*) begin
        data_out = intermediate[11:4] ^ data_in;
    end

endmodule

-→ testbench

`timescale 1ns/1ps

module testbench;

    reg clk;
    reg rst_n;
    reg [7:0] data_in;

    wire [7:0] data_out;
    wire valid_out;

    reg [15:0] expected_intermediate;
    reg [7:0] expected_out;
    integer i;
    integer errors;

    top dut (
        .clk(clk),
        .rst_n(rst_n),
        .data_in(data_in),
        .data_out(data_out),
        .valid_out(valid_out)
    );

    always #5 clk = ~clk;

    initial begin
        $dumpfile("sta_design.vcd");
        $dumpvars(0, testbench);

        clk = 0;
        rst_n = 0;
        data_in = 0;
        errors = 0;

        repeat (2) @(negedge clk);
        rst_n = 1;

        for (i = 0; i < 256; i = i + 1) begin
            @(negedge clk);
            data_in = i[7:0];
            #1;

            expected_intermediate =
                (i * i) + ((i & 15) * 16);

            expected_out =
                expected_intermediate[11:4] ^ i[7:0];

            if (data_out !== expected_out) begin
                $display("FAIL: input=%0d got=%0d expected=%0d",
                         i, data_out, expected_out);
                errors = errors + 1;
            end
        end

        if (errors == 0)
            $display("PASS: All 256 input values checked.");
        else
            $display("FAIL: %0d errors found.", errors);

        $finish;
    end

endmodule
